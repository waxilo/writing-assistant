{
  "name": "writer-demo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --test src/utils/token.test.ts src/utils/password.test.ts src/utils/validate.test.ts src/utils/saveHash.test.ts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply writer-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply writer-demo --remote"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.113.0"
  }
}