{
  "name": "writing-assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:mysql2 --sourcemap",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/utils/token.test.ts src/utils/password.test.ts src/utils/validate.test.ts src/utils/saveHash.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "mysql2": "^3.24.4"
  }
}
