# 数据库连接：复用 ../mysql-server 容器（compose 网络内的服务名是 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=writing_assistant
DB_USER=writing_assistant
# 由 scripts/db-init.sh 生成并写入 .env（不要把真实密码提交进仓库）
DB_PASSWORD=

# 令牌签名密钥，各需 >= 32 字符且互相独立。留空则 db-init.sh 自动生成。
# 轮换 TOKEN_SECRET 会让所有已登录的访问令牌立即失效（重新登录即可）。
TOKEN_SECRET=
REFRESH_SECRET=

# 对外监听：默认仅本机可访问
APP_BIND_ADDR=127.0.0.1
APP_PORT=8787

# 公网访问（Cloudflare Tunnel，可选）：./scripts/tunnel-init.sh 会写入这三行。
# COMPOSE_PROFILES 打开 docker-compose.yml 里的 tunnel 服务；不开则完全不涉及。
COMPOSE_PROFILES=
# 隧道私钥在仓库内的落点（已 gitignore，撤销方式是删除隧道本身）
CF_CRED_FILE=
# 有代理在前（cloudflared / nginx 等）时必须为 1，否则客户端 IP 全是 127.0.0.1
TRUST_PROXY=0
